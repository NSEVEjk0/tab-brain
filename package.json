{
  "name": "tab-brain",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "Save readable tabs, keep private notes, revisit bookmarks, and compare approved sources with Firebase AI.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build && node scripts/build-extension.mjs && python3 scripts/package.py",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.0.0",
    "@fontsource/instrument-serif": "^5.0.0",
    "@mozilla/readability": "^0.6.0",
    "firebase": "13.3.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
